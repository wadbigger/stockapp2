# ============================================
# StockApp — Configuration de Production
# ============================================
# Copiez ce fichier en .env et modifiez les valeurs

# --- Base de données ---
POSTGRES_DB=stockapp
POSTGRES_USER=stockapp
POSTGRES_PASSWORD=CHANGEZ_MOI_un_mot_de_passe_fort

# --- Sécurité JWT (générez des clés aléatoires longues) ---
JWT_SECRET=CHANGEZ_MOI_generez_une_cle_aleatoire_de_64_caracteres
JWT_REFRESH_SECRET=CHANGEZ_MOI_generez_une_autre_cle_aleatoire_64_chars

# --- Email (optionnel, pour alertes stock) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@votreentreprise.com

# --- URL publique (laisser vide si même serveur) ---
# Si votre app est sur https://stock.monentreprise.com, mettez :
# VITE_API_URL=https://stock.monentreprise.com
VITE_API_URL=https://api.stockapp.shop

# --- Port d'accès public ---
APP_PORT=80
