NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stockapp:stockapp_password@localhost:5432/stockapp
JWT_SECRET=changez_cette_valeur_en_production
JWT_REFRESH_SECRET=changez_cette_valeur_aussi_en_production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@example.com

# --- Multi-tenant platform (Phase 1) ---
# Control-plane database: tenant registry, email->tenant index, backup metadata.
CONTROL_DB_URL=postgresql://user:password@localhost:5432/stockapp_platform
# Connection used only to CREATE/DROP DATABASE during tenant provisioning (must point at the "postgres" maintenance DB).
PG_ADMIN_URL=postgresql://user:password@localhost:5432/postgres
# Per-tenant database server (all tenant DBs live here, one DB per tenant).
PG_TENANT_HOST=localhost
PG_TENANT_PORT=5432
PG_TENANT_USER=changez_moi
PG_TENANT_PASSWORD=changez_moi
TENANT_POOL_MAX=5
# Bearer token for the /api/platform/* superadmin endpoints — generate a long random value, never reuse across environments.
PLATFORM_ADMIN_TOKEN=changez_moi_generez_un_token_aleatoire_long
# Where pg_dump backups are written; pg_dump/pg_restore must be on PATH (e.g. C:\Program Files\PostgreSQL\<version>\bin).
BACKUPS_DIR=backend/backups
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Dev/local convenience only — seeds demo users into DATABASE_URL directly, bypassing tenant provisioning.
SEED_DEMO_DATA=false
